###############################################################################
# Nubetiza Environment Variables                                               #
# Copy this file to .env and adjust values for your deployment                 #
###############################################################################

# REQUIRED: A long, random secret key. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
PAPERLESS_SECRET_KEY=change-me-to-a-long-random-string

# Public URL where Nubetiza will be accessible (used for CSRF, CORS, links)
# Example: https://docs.example.com
PAPERLESS_URL=

# Database credentials (must match between webserver and db services)
PAPERLESS_DBNAME=nubetiza
PAPERLESS_DBUSER=nubetiza
PAPERLESS_DBPASS=nubetiza

# Initial admin account (only used on first run)
PAPERLESS_ADMIN_USER=admin
PAPERLESS_ADMIN_PASSWORD=changeme
PAPERLESS_ADMIN_MAIL=admin@example.com

# Timezone (default: UTC)
PAPERLESS_TIME_ZONE=UTC

# OCR language (default: eng). See Tesseract docs for language codes.
PAPERLESS_OCR_LANGUAGE=eng

# Port to expose (default: 8000)
PAPERLESS_PORT=8000

# Container user/group mapping (default: 1000)
USERMAP_UID=1000
USERMAP_GID=1000

# Docker Compose project name
COMPOSE_PROJECT_NAME=nubetiza
